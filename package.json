{
  "name": "telegram_system",
  "version": "0.1.0",
  "private": true,
  "description": "Internal system for Telegram channel finance, ads, campaigns and analytics.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @telegram-system/shared build",
    "dev": "pnpm dev:nexeloq",
    "dev:local": "node scripts/dev/dev-products.mjs nexeloq",
    "dev:prod-ui": "node scripts/dev/dev-production.mjs ui",
    "dev:prod-operator": "node scripts/dev/dev-production.mjs operator",
    "dev:nexeloq": "node scripts/dev/dev-products.mjs nexeloq",
    "dev:finance": "node scripts/dev/dev-products.mjs finance",
    "dev:all": "node scripts/dev/dev-products.mjs all",
    "dev:all:tunnel": "node scripts/dev/dev-products.mjs all --cloudflare --system-bot",
    "dev:stop": "node scripts/dev/stop-local-dev.mjs",
    "dev:finance:tunnel": "node scripts/dev/dev-tunnel.mjs --cloudflare --finance",
    "dev:bots": "TUNNEL_TARGET_PORT=4000 node scripts/dev/dev-tunnel.mjs --cloudflare --bots",
    "dev:local-bot": "TUNNEL_TARGET_PORT=4000 node scripts/dev/dev-tunnel.mjs --cloudflare --bots",
    "dev:system-bot": "TUNNEL_TARGET_PORT=4000 node scripts/dev/dev-tunnel.mjs --cloudflare --system-bot",
    "dev:plain": "pnpm dev:nexeloq",
    "dev:web": "NEXT_PUBLIC_API_URL=http://localhost:4000/api pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "graph": "node scripts/quality/code-graph.mjs",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --filter @telegram-system/shared typecheck && pnpm --filter api typecheck && pnpm --filter web typecheck && pnpm --filter finance-api prisma:generate && pnpm --filter finance-api typecheck && pnpm --filter @telegram-system/finance-web typecheck",
    "test": "pnpm test:api && pnpm test:web && pnpm test:finance",
    "test:deployment": "node --test scripts/dev/*.test.mjs scripts/deployment/*.test.mjs && node scripts/deployment/check-railway-build.mjs",
    "env:check": "node scripts/quality/check-env-profile.mjs",
    "i18n:check": "node scripts/quality/check-i18n.mjs",
    "architecture:check": "node --test scripts/quality/architecture-policy.test.mjs && node scripts/quality/check-architecture.mjs",
    "test:api": "pnpm --filter api exec jest --runInBand",
    "test:web": "pnpm --filter web exec vitest run",
    "test:finance": "pnpm --filter finance-api test && pnpm --filter @telegram-system/finance-web exec vitest run",
    "check": "pnpm db:generate && pnpm architecture:check && pnpm i18n:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:changed": "node scripts/quality/check-changed.mjs",
    "db:up": "docker compose up -d postgres",
    "db:snapshot:refresh": "node scripts/db/refresh-local-db.mjs",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:deploy:safe": "pnpm --filter api run db:deploy:safe",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "ai:sync": "node scripts/ai/sync-local-ai-costs.mjs",
    "ai:sync:check": "node scripts/ai/sync-local-ai-costs.mjs --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "release:check": "pnpm ai:sync:check && node scripts/quality/check-changed.mjs --release",
    "production:ads": "node scripts/production/production-ads.mjs",
    "production:recovery": "node scripts/production/production-recovery.mjs",
    "archive": "python3 scripts/build/source-archive.py",
    "avatar-emoji": "pnpm --filter api avatar-emoji",
    "test:tooling": "node --test scripts/ai/*.test.mjs scripts/qa/lead-review/*.test.* scripts/qa/crm-ai/*.test.mjs && python3 scripts/build/source-archive.test.py"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "next": "16.2.6",
    "playwright-core": "^1.64.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
