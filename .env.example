# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# API
API_PORT="4000"
API_PUBLIC_URL="http://localhost:4000"
JWT_SECRET=""
BOT_TOKEN_ENCRYPTION_KEY=""

# Frontend
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Password reset email (optional in development, required in production)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Telegram runtime
TELEGRAM_BOT_RUNTIME_ENVIRONMENT="LOCAL"

# Telegram API
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Telegram System Bot
TELEGRAM_SYSTEM_BOT_ENVIRONMENT=""
TELEGRAM_SYSTEM_BOT_LOCAL_USERNAME=""
TELEGRAM_SYSTEM_BOT_LOCAL_TOKEN=""
TELEGRAM_SYSTEM_BOT_LOCAL_WEBHOOK_SECRET=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_USERNAME=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_TOKEN=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_WEBHOOK_SECRET=""
TELEGRAM_SYSTEM_BOT_DASHBOARD_WORKSPACE_ID=""

# Read-only Finance analytics bridge for the authenticated Nexeloq admin API
FINANCE_BOT_DASHBOARD_WORKSPACE_ID=""
FINANCE_ADMIN_ANALYTICS_URL=""
FINANCE_ADMIN_ANALYTICS_TOKEN=""

# Web Push (all blank disables push)
WEB_PUSH_VAPID_SUBJECT=""
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# Backblaze B2
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET_NAME="telegram-system"
B2_ENDPOINT=""

# Logs
APP_LOG_MIN_LEVEL="error"
APP_CONSOLE_LOG_LEVEL="warn"
APP_LOG_HTTP_ENABLED="true"
APP_LOG_HTTP_SUCCESS_ENABLED="false"
TRUST_PROXY_HOPS="1"

# Memory monitoring
MEMORY_MONITOR_ENABLED="true"
MEMORY_MONITOR_WARN_RSS_MB="400"
MEMORY_MONITOR_DETAILED_TELEMETRY="false"


# Internal AI Gateway
# Only the API receiving CRM traffic should own Telegram sessions for a shared database.
CRM_RUNTIME_ENABLED=true
# Relay CRM HTTP/SSE to this trusted API origin; a relay never opens Telegram sessions.
CRM_RUNTIME_PROXY_URL=
# Optional local multi-API profile: only this API port may own the shared sessions.
CRM_RUNTIME_OWNER_API_PORT=
# Enables authorized, on-demand Telegram attachment reads; no background downloads.
CRM_CHAT_MEDIA_ENABLED=false

INTERNAL_AI_ENABLED=false
INTERNAL_AI_OPENAI_API_KEY=

# Sales Copilot processing
INTERNAL_AI_SALES_PROCESSING_ENABLED=false
# JSON array of approved workspace grants (scope WORKSPACE) or contact grants.
# A workspace grant covers all CRM conversations in that workspace; never put API keys here.
INTERNAL_AI_SALES_PROCESSING_GRANTS='[]'

# Lead Discovery
INTERNAL_LEAD_DISCOVERY_ENABLED=false
INTERNAL_LEAD_DISCOVERY_RECOVERY_MODE=normal
# JSON array of approved workspace/account/channel ingest and AI grants.
INTERNAL_LEAD_DISCOVERY_GRANTS='[]'

# Lead Qualification
INTERNAL_LEAD_QUALIFICATION_ENABLED=false
VERCEL_API_TOKEN=""
