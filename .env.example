# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_system?schema=public"

# API
API_PORT="4000"
API_PUBLIC_URL="http://localhost:4000"
JWT_SECRET=""
BOT_TOKEN_ENCRYPTION_KEY=""
PRISMA_BASELINE_RECONCILE="1"

# Frontend
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Railway's single-service build sets this to true so Next proxies /api to Nest.
RAILWAY_API_PROXY=""
# Exact dev gateway origins that must proxy Finance consumer calls through same-origin /api.
NEXT_PUBLIC_FINANCE_CONSUMER_GATEWAY_ORIGINS=""
FINANCE_MINI_APP_URL=""

# Telegram runtime
TELEGRAM_BOT_RUNTIME_ENVIRONMENT="LOCAL"
TELEGRAM_BOT_WEBHOOK_BASE_URL=""
TELEGRAM_UPDATES_MODE="webhook"
TELEGRAM_SYNC_ENABLED="true"
TELEGRAM_SYNC_INTERVAL_MINUTES="5"
TELEGRAM_DAILY_ANALYTICS_SYNC_ENABLED="true"

# Telegram API
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_ACCOUNT_CAPABILITY_TTL_HOURS="24"
TELEGRAM_ACCOUNT_CAPABILITY_REFRESH_CONCURRENCY="2"
TELEGRAM_ACCOUNT_CAPABILITY_CHECK_TIMEOUT_MS="20000"

# Telegram System Bot
TELEGRAM_SYSTEM_BOT_ENVIRONMENT=""
TELEGRAM_SYSTEM_BOT_LOCAL_USERNAME=""
TELEGRAM_SYSTEM_BOT_LOCAL_TOKEN=""
TELEGRAM_SYSTEM_BOT_LOCAL_WEBHOOK_SECRET=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_USERNAME=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_TOKEN=""
TELEGRAM_SYSTEM_BOT_PRODUCTION_WEBHOOK_SECRET=""
TELEGRAM_SYSTEM_BOT_WEBHOOK_BASE_URL=""

# Backblaze B2
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET_NAME="telegram-system"
B2_ENDPOINT=""

# Logs
APP_LOG_RETENTION_DAYS="90"
APP_LOG_BATCH_SIZE="50"
APP_LOG_FLUSH_INTERVAL_MS="1000"
APP_LOG_MIN_LEVEL="error"
APP_CONSOLE_LOG_LEVEL="warn"
APP_LOG_HTTP_ENABLED="true"
APP_LOG_HTTP_SUCCESS_ENABLED="false"
APP_LOG_HTTP_SLOW_REQUEST_MS="0"

# Memory monitoring
MEMORY_MONITOR_ENABLED="true"
MEMORY_MONITOR_INTERVAL_MS="30000"
MEMORY_MONITOR_WARN_RSS_MB="400"
MEMORY_MONITOR_RECOVERY_RSS_MB="360"
MEMORY_MONITOR_REMINDER_INTERVAL_MS="900000"
MEMORY_MONITOR_DETAILED_TELEMETRY="false"
