{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "react", "react-dom"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@finance-pro/web/components/*": ["../../products/finance-pro/web/components/*"],
      "@finance-pro/web/lib/*": ["../../products/finance-pro/web/lib/*"],
      "@finance-pro/web/provider/*": ["../../products/finance-pro/web/provider/*"],
      "@greeter/web/components/*": ["../../products/greeter/web/components/*"],
      "@greeter/web/lib/*": ["../../products/greeter/web/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
