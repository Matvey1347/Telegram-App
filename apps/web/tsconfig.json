{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "react", "react-dom"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@finance-web/*": ["../standalone/finance/web/src/*"],
      "@consumer-finance/web/components/*": ["../../products/finance/web/components/*"],
      "@consumer-finance/web/lib/*": ["../../products/finance/web/lib/*"],
      "@consumer-finance/web/provider/*": ["../../products/finance/web/provider/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next/live-ui/types/**/*.ts",
    ".next/live-ui/dev/types/**/*.ts",
    ".next/live-operator/types/**/*.ts",
    ".next/live-operator/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
