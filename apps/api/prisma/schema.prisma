  priorities        String?
  fixedExpenses     String?
  protectedExpenses String?
  constraints       String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  profile           FinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model AiUsageEvent {
  id                               String            @id @default(cuid())
