  updatedAt         DateTime              @updatedAt
  profile           FinanceProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  telegramUser      TelegramBotUser       @relation(fields: [telegramBotUserId], references: [id], onDelete: Cascade)

  @@index([botIntegrationId, telegramBotUserId, status, expiresAt], map: "FinancePendingProposal_botIntegrationId_telegramBotUserId_statu")
}

model FinanceAssistantProfile {
  id                String         @id @default(cuid())
  profileId         String         @unique
