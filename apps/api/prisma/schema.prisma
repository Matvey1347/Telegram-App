  @@index([workspaceId, actorMemberId, createdAt])
  @@index([telegramChannelId, createdAt])
  @@index([groupId, status, statusPosition])
}

model PostGroup {
  id                     String  @id @default(cuid())
  workspaceId            String
  telegramChannelId      String
  title                  String
  description            String?
  icon                   String?
  isSystem               Boolean @default(false)
  systemKey              String?
  statusNumberingEnabled Boolean @default(false)
  createdByMemberId      String
  sidebarPosition        Int?

  workspace            Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel      TelegramChannel               @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  createdByMember      WorkspaceMember               @relation("PostGroupCreatedByMember", fields: [createdByMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  posts                TelegramManagedPost[]
  managedPostRevisions TelegramManagedPostRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([telegramChannelId, systemKey])
  @@index([workspaceId])
  @@index([telegramChannelId])
  @@index([createdByMemberId])
  @@index([telegramChannelId, sidebarPosition])
}

model TelegramPostMetricSnapshot {
