  timezone               String                         @default("Europe/Warsaw")
  locale                 String?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  botIntegration         TelegramBotIntegration         @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)
  telegramUser           TelegramBotUser                @relation(fields: [telegramBotUserId], references: [id], onDelete: Cascade)
  accounts               FinanceAccount[]
  categories             FinanceCategory[]
  transactions           FinanceTransaction[]
  transfers              FinanceTransfer[]
  merchantMappings       FinanceMerchantMapping[]
  limits                 FinanceSpendingLimit[]
  reminders              FinanceReminder[]
  goals                  FinanceGoal[]
  proposals              FinancePendingProposal[]
  assistantProfile       FinanceAssistantProfile?
  aiUsage                AiUsageEvent[]
  chatFlows              FinanceChatFlow[]
  consumerTransfers      FinanceConsumerTransfer[]
  browserLoginChallenges FinanceBrowserLoginChallenge[]

  @@unique([botIntegrationId, telegramBotUserId])
}

// Explicit Mini App -> browser handoff only. Raw bearer values are never persisted.
// Expiry is enforced on consume; no background cleanup is required for correctness.
model FinanceConsumerTransfer {
  id         String    @id @default(cuid())
  profileId  String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  profile FinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Browser login is approved by the same Telegram user inside the Finance bot.
// Only a hash of the deep-link bearer token is persisted. Expiry is enforced
// while approving and consuming, so no recurring cleanup job is required.
model FinanceBrowserLoginChallenge {
  id                String    @id @default(cuid())
  botIntegrationId  String
  approvedProfileId String?
  tokenHash         String    @unique
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())

  botIntegration  TelegramBotIntegration @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)
  approvedProfile FinanceProfile?        @relation(fields: [approvedProfileId], references: [id], onDelete: Cascade)

  @@index([botIntegrationId, expiresAt])
  @@index([approvedProfileId])
}

// A nullable bot means a workspace default. A bot-specific row overrides it.
// Secrets use the same AES-GCM envelope as Bot API and billing credentials.
model AiProviderConfig {
  id                  String                    @id @default(cuid())
  workspaceId         String
  botIntegrationId    String?
  provider            FinanceAiProvider         @default(OPENAI)
  apiKeyEncrypted     String?
  apiKeyIv            String?
  apiKeyAuthTag       String?
  connectionStatus    FinanceAiConnectionStatus @default(NOT_CONFIGURED)
  lastCheckedAt       DateTime?
  lastValidationError String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botIntegration      TelegramBotIntegration?   @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, botIntegrationId, provider], map: "FinanceAiProviderConfig_workspaceId_botIntegrationId_provider_k")
  @@index([workspaceId, provider])
  @@map("FinanceAiProviderConfig")
}

model FinanceAccount {
  id                String               @id @default(cuid())
  profileId         String
  name              String
  /// Unicode, canonical Telegram Custom Emoji markup, or an immutable image source.
  emoji             String?              @db.Text
  type              FinanceAccountType   @default(OTHER)
  currency          String               @db.VarChar(3)
  openingBalance    Decimal              @default(0)
  archivedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  profile           FinanceProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions      FinanceTransaction[]
  outgoingTransfers FinanceTransfer[]    @relation("FinanceOutgoingTransfers")
  incomingTransfers FinanceTransfer[]    @relation("FinanceIncomingTransfers")

  @@index([profileId, archivedAt])
}

model FinanceCategory {
  id               String                   @id @default(cuid())
  profileId        String
  parentId         String?
  name             String
  /// Unicode, canonical Telegram Custom Emoji markup, or an immutable image source.
  emoji            String?                  @db.Text
  type             FinanceTransactionType
  key              String?
  archivedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  profile          FinanceProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent           FinanceCategory?         @relation("FinanceCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children         FinanceCategory[]        @relation("FinanceCategoryChildren")
  transactions     FinanceTransaction[]
  transactionItems FinanceTransactionItem[]
  limits           FinanceSpendingLimit[]

  @@unique([profileId, type, key])
  @@index([profileId, parentId])
}

model FinanceTransaction {
  id                        String                   @id @default(cuid())
  profileId                 String
  accountId                 String
  categoryId                String?
  type                      FinanceTransactionType
  amount                    Decimal
  currency                  String                   @db.VarChar(3)
  amountInDefaultCurrency   Decimal
  exchangeRateToDefault     Decimal
  // Immutable USD valuation. Legacy rows may be null until they are edited;
  // do not reinterpret amountInDefaultCurrency after a default-currency change.
  valuationCurrency         String?                  @db.VarChar(3)
  amountInValuationCurrency Decimal?
  exchangeRateToValuation   Decimal?
  valuationRateAt           DateTime?
  occurredAt                DateTime
  description               String?
  merchantDisplay           String?
  merchantNormalized        String?
  source                    FinanceTransactionSource @default(CHAT)
  deletedAt                 DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  profile                   FinanceProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account                   FinanceAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category                  FinanceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items                     FinanceTransactionItem[]

  @@index([profileId, occurredAt])
  @@index([profileId, accountId, occurredAt])
  @@index([profileId, categoryId, occurredAt])
  @@index([profileId, merchantNormalized, occurredAt])
}

// Receipt/products are detail of one ledger purchase, never separate ledger rows.
model FinanceTransactionItem {
  id             String             @id @default(cuid())
  transactionId  String
  displayName    String
  normalizedName String?
  quantity       Decimal?
  unitPrice      Decimal?
  totalAmount    Decimal
  currency       String             @db.VarChar(3)
  categoryId     String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transaction    FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category       FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([categoryId])
}

model FinanceChatFlow {
  id                String         @id @default(cuid())
  profileId         String
  botIntegrationId  String
  telegramBotUserId String
  operationKind     String         @db.VarChar(40)
  step              String         @db.VarChar(80)
  status            String         @default("ACTIVE") @db.VarChar(24)
  payload           Json           @default("{}")
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  profile           FinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([botIntegrationId, telegramBotUserId])
  @@index([profileId, expiresAt])
  @@index([expiresAt])
}

model FinanceTransfer {
  id            String         @id @default(cuid())
  profileId     String
  fromAccountId String
  toAccountId   String
  fromAmount    Decimal
  fromCurrency  String         @db.VarChar(3)
  toAmount      Decimal
  toCurrency    String         @db.VarChar(3)
  exchangeRate  Decimal?
  occurredAt    DateTime
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       FinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fromAccount   FinanceAccount @relation("FinanceOutgoingTransfers", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     FinanceAccount @relation("FinanceIncomingTransfers", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([profileId, occurredAt])
}

model FinanceMerchantMapping {
  id                 String         @id @default(cuid())
  profileId          String
  merchantNormalized String
  categoryId         String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  profile            FinanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, merchantNormalized])
}

model FinanceSpendingLimit {
  id         String             @id @default(cuid())
  profileId  String
  categoryId String
  amount     Decimal
  currency   String             @db.VarChar(3)
  period     FinanceLimitPeriod @default(MONTH)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  profile    FinanceProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category   FinanceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([profileId, categoryId, period])
}

model FinanceReminder {
  id                    String                    @id @default(cuid())
  profileId             String
  name                  String
  amount                Decimal
  currency              String                    @db.VarChar(3)
  recurrence            FinanceReminderRecurrence @default(MONTHLY)
