  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([environment, updateId])
  @@index([status, createdAt])
}

model TelegramPost {
  id                   String   @id @default(cuid())
  workspaceId          String
  telegramChannelId    String
  telegramMessageId    String
  text                 String?
  formattedText        String?
  hasMedia             Boolean  @default(false)
  mediaKind            String?
  imageUrls            String[] @default([])
  postDate             DateTime
  viewsCount           Int?
  forwardsCount        Int?
  reactionsCount       Int?
  commentsCount        Int?
  manualOwnViews       Int      @default(0)
  manualOwnReactions   Int      @default(0)
  excludeFromAnalytics Boolean  @default(false)
  reactions            Json?
  rawMessage           Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace        Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel  TelegramChannel              @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  metricSnapshots  TelegramPostMetricSnapshot[]
  adSalePlacements TelegramAdSalePlacement[]    @relation("TelegramAdPlacementTelegramPost")

  @@unique([telegramChannelId, telegramMessageId])
  @@index([telegramChannelId, postDate])
  @@index([workspaceId, telegramChannelId, postDate])
}

model TelegramManagedPost {
  id                           String                                  @id @default(cuid())
  workspaceId                  String
  telegramChannelId            String
  title                        String
  text                         String?
  imageUrls                    String[]                                @default([])
  buttonRows                   Json?
  origin                       TelegramManagedPostOrigin               @default(SYSTEM)
  remoteImportKey              String?
  jsonImportKey                String?
  status                       TelegramManagedPostStatus               @default(DRAFT)
  scheduledAt                  DateTime?
  scheduleMode                 String?
  publishedAt                  DateTime?
  telegramScheduledMessageIds  String[]                                @default([])
  telegramMessageIds           String[]                                @default([])
  telegramMessageUrls          String[]                                @default([])
  telegramIdVerificationStatus TelegramManagedPostIdVerificationStatus @default(UNVERIFIED)
  telegramLinkSource           TelegramManagedPostLinkSource           @default(AUTO)
  telegramIdVerifiedAt         DateTime?
  telegramIdLastCheckedAt      DateTime?
  telegramRemoteStatus         TelegramManagedPostRemoteStatus         @default(NONE)
  lastTelegramSyncedAt         DateTime?
  lastTelegramSyncNote         String?
  sourceType                   TelegramSourceType?
  sourceId                     String?
  sourceWasPremium             Boolean?
  captionLengthMaxUsed         Int?
  messageLengthMaxUsed         Int?
  publishMode                  String?
  lastError                    String?
  plannerFormatId              String?
  plannerSlotId                String?
  plannerRunId                 String?
  plannerPlannedAt             DateTime?
  plannerProvenance            Json?
  assignedMemberId             String
  icon                         String?
  groupId                      String?
  groupPosition                Int?
  statusPosition               Int?
  sidebarPosition              Int?

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel  TelegramChannel               @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  assignedMember   WorkspaceMember               @relation("TelegramManagedPostAssignedMember", fields: [assignedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict, map: "TelegramManagedPost_assignedMemberId_fkey")
  group            PostGroup?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  plannerFormat    TelegramPostPlannerFormat?    @relation(fields: [plannerFormatId], references: [id], onDelete: SetNull)
  plannerSlot      TelegramPostPlannerSlot?      @relation(fields: [plannerSlotId], references: [id], onDelete: SetNull)
  revisions        TelegramManagedPostRevision[]
  adSalePlacements TelegramAdSalePlacement[]     @relation("TelegramAdPlacementManagedPost")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, telegramChannelId, jsonImportKey], map: "TelegramManagedPost_workspaceId_telegramChannelId_jsonImportKey")
  // Enforced by a partial unique index in the baseline migration. Prisma's
  // schema language cannot represent `WHERE remoteImportKey IS NOT NULL`.
  @@index([workspaceId, telegramChannelId, createdAt])
  @@index([workspaceId, assignedMemberId])
  @@index([groupId])
  @@index([groupId, groupPosition])
  @@index([groupId, status, statusPosition])
  @@index([telegramChannelId, sidebarPosition])
  @@index([workspaceId, telegramChannelId, plannerRunId], map: "TelegramManagedPost_workspaceId_telegramChannelId_plannerRunId_")
  @@index([workspaceId, telegramChannelId, plannerSlotId], map: "TelegramManagedPost_workspaceId_telegramChannelId_plannerSlotId")
  @@index([status, scheduledAt])
  @@index([telegramIdVerificationStatus, status, telegramIdLastCheckedAt], map: "TelegramManagedPost_due_identity_idx")
  @@index([workspaceId, telegramChannelId, origin, status, scheduledAt], map: "TelegramManagedPost_workspaceId_telegramChannelId_origin_status")
}

model TelegramPostPlannerFormat {
  id                String  @id @default(cuid())
  workspaceId       String
  telegramChannelId String
  name              String
  description       String?
  icon              String?
  position          Int     @default(0)
  isActive          Boolean @default(true)

  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel TelegramChannel           @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  slots           TelegramPostPlannerSlot[]
  plannedPosts    TelegramManagedPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, telegramChannelId, name], map: "TelegramPostPlannerFormat_workspaceId_telegramChannelId_name_ke")
  @@index([workspaceId, telegramChannelId, position], map: "TelegramPostPlannerFormat_workspaceId_telegramChannelId_positio")
  @@index([workspaceId, telegramChannelId, isActive], map: "TelegramPostPlannerFormat_workspaceId_telegramChannelId_isActiv")
}

model TelegramPostPlannerSlot {
  id                String   @id @default(cuid())
  workspaceId       String
  telegramChannelId String
  formatId          String?
  postGroupIds      String[] @default([])
  weekday           Int
  time              String   @db.VarChar(5)
  timezone          String
  position          Int      @default(0)
  isActive          Boolean  @default(true)

  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel TelegramChannel            @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  format          TelegramPostPlannerFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  plannedPosts    TelegramManagedPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, telegramChannelId, weekday, position], map: "TelegramPostPlannerSlot_workspaceId_telegramChannelId_weekday_p")
  @@index([workspaceId, telegramChannelId, isActive], map: "TelegramPostPlannerSlot_workspaceId_telegramChannelId_isActive_")
  @@index([workspaceId, telegramChannelId, formatId], map: "TelegramPostPlannerSlot_workspaceId_telegramChannelId_formatId_")
}

model TelegramManagedPostRevision {
  id                           String                                  @id @default(cuid())
  telegramManagedPostId        String
  workspaceId                  String
  telegramChannelId            String
  title                        String
  text                         String?
  imageUrls                    String[]                                @default([])
  buttonRows                   Json?
  origin                       TelegramManagedPostOrigin               @default(SYSTEM)
  remoteImportKey              String?
  status                       TelegramManagedPostStatus
  scheduledAt                  DateTime?
  scheduleMode                 String?
  publishedAt                  DateTime?
  telegramScheduledMessageIds  String[]                                @default([])
  telegramMessageIds           String[]                                @default([])
  telegramMessageUrls          String[]                                @default([])
  telegramIdVerificationStatus TelegramManagedPostIdVerificationStatus @default(UNVERIFIED)
  telegramLinkSource           TelegramManagedPostLinkSource           @default(AUTO)
  telegramIdVerifiedAt         DateTime?
  telegramIdLastCheckedAt      DateTime?
  telegramRemoteStatus         TelegramManagedPostRemoteStatus         @default(NONE)
  lastTelegramSyncedAt         DateTime?
  lastTelegramSyncNote         String?
  sourceType                   TelegramSourceType?
  sourceId                     String?
  sourceWasPremium             Boolean?
  captionLengthMaxUsed         Int?
  messageLengthMaxUsed         Int?
  publishMode                  String?
  lastError                    String?
  assignedMemberId             String
  actorMemberId                String?
  icon                         String?
  groupId                      String?
  groupPosition                Int?
  statusPosition               Int?
  sidebarPosition              Int?
  reason                       String

  telegramManagedPost TelegramManagedPost @relation(fields: [telegramManagedPostId], references: [id], onDelete: Cascade)
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel     TelegramChannel     @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  assignedMember      WorkspaceMember     @relation("TelegramManagedPostRevisionAssignedMember", fields: [assignedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
