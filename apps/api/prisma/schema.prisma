  lastCheckedAt          DateTime?
  lastValidationError    String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botIntegration TelegramBotIntegration? @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, botIntegrationId, provider, mode], map: "BotBillingProviderConfig_workspaceId_botIntegrationId_provider_")
  @@index([workspaceId, provider, mode])
}

model BotSubscriptionPlan {
  id               String   @id @default(cuid())
  workspaceId      String
  botIntegrationId String
  code             String
  name             String
  description      String?
  freeCapabilities String[] @default([])
  paidCapabilities String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botIntegration TelegramBotIntegration @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)
  prices         BotPlanPrice[]
  subscriptions  BotSubscription[]
  coupons        BotCoupon[]

  @@unique([botIntegrationId, code])
  @@index([workspaceId, botIntegrationId, isActive])
}

model BotPlanPrice {
  id                    String             @id @default(cuid())
  planId                String
  version               Int
  currency              String             @db.VarChar(3)
  interval              BotBillingInterval
  amountMinor           Int
  isPublic              Boolean            @default(true)
  isActive              Boolean            @default(true)
  providerPriceIdentity Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  plan              BotSubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions     BotSubscription[]
  couponRedemptions BotCouponRedemption[]

  @@unique([planId, currency, interval, version])
  @@index([planId, currency, interval, isPublic, isActive])
}

model BotSubscription {
  id                     String                @id @default(cuid())
  workspaceId            String
  botIntegrationId       String
  telegramBotUserId      String
  planId                 String?
  planPriceId            String?
  source                 BotSubscriptionSource
  status                 BotSubscriptionStatus @default(INCOMPLETE)
  currency               String?               @db.VarChar(3)
  interval               BotBillingInterval?
  amountMinor            Int?
  priceVersion           Int?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  canceledAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botIntegration       TelegramBotIntegration   @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)
  telegramBotUser      TelegramBotUser          @relation(fields: [telegramBotUserId], references: [id], onDelete: Cascade)
  plan                 BotSubscriptionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planPrice            BotPlanPrice?            @relation(fields: [planPriceId], references: [id], onDelete: SetNull)
  grants               BotSubscriptionGrant[]
  events               BotBillingEvent[]
  providerSubscription BotProviderSubscription?

  @@index([workspaceId, botIntegrationId, status])
  @@index([workspaceId, botIntegrationId, createdAt])
  @@index([telegramBotUserId, status, currentPeriodEnd])
  @@index([providerSubscriptionId])
}

model BotSubscriptionGrant {
  id              String                     @id @default(cuid())
  subscriptionId  String
  source          BotSubscriptionGrantSource
  reason          String
  idempotencyKey  String                     @unique
  startsAt        DateTime                   @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  subscription BotSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, expiresAt, revokedAt])
}

model BotCoupon {
  id                     String    @id @default(cuid())
  workspaceId            String
  botIntegrationId       String
  planId                 String?
  code                   String
  percentOff             Int?
  amountOffMinor         Int?
  currency               String?   @db.VarChar(3)
  startsAt               DateTime?
  expiresAt              DateTime?
  maxRedemptions         Int?
  newUsersOnly           Boolean   @default(false)
  isActive               Boolean   @default(true)
  /// Provider identities are mode-scoped (for example STRIPE.TEST/LIVE) and
  /// must never be reused across Stripe accounts or modes.
  providerCouponIdentity Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botIntegration TelegramBotIntegration @relation(fields: [botIntegrationId], references: [id], onDelete: Cascade)
  plan           BotSubscriptionPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  redemptions    BotCouponRedemption[]

  @@unique([botIntegrationId, code])
  @@index([workspaceId, botIntegrationId, isActive])
}

model BotCouponRedemption {
  id                String   @id @default(cuid())
  couponId          String
  telegramBotUserId String
  planPriceId       String
  subscriptionId    String?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())

  coupon          BotCoupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  telegramBotUser TelegramBotUser @relation(fields: [telegramBotUserId], references: [id], onDelete: Cascade)
  planPrice       BotPlanPrice    @relation(fields: [planPriceId], references: [id], onDelete: Restrict)

  @@unique([couponId, telegramBotUserId, planPriceId])
  @@index([couponId, createdAt])
}

model BotProviderCustomer {
