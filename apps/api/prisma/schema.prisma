  @@index([profileId, createdAt, feature])
  @@index([profileId, feature, status, createdAt])
  @@index([workspaceId, botIntegrationId, runtimeInstanceId, createdAt], map: "FinanceAiUsage_workspace_bot_runtime_created_idx")
  @@index([telegramBotUserId, createdAt], map: "FinanceAiUsage_user_created_idx")
  @@map("FinanceAiUsage")
}

model BotBillingProviderConfig {
  id                     String                     @id @default(cuid())
  workspaceId            String
  botIntegrationId       String?
