  cachedInputTokens                Int?
  outputTokens                     Int?
  inputAudioTokens                 Int?
  outputAudioTokens                Int?
  inputPriceMicrosPerMillion       Int?
  cachedInputPriceMicrosPerMillion Int?
  outputPriceMicrosPerMillion      Int?
  pricingVersion                   String?
  estimatedCostMicros              Int?
  latencyMs                        Int
  status                           String
