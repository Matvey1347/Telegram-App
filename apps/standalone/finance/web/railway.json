{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @telegram-system/shared build && NEXT_PUBLIC_FINANCE_API_URL=/api pnpm --filter @telegram-system/finance-web build",
    "watchPatterns": [
      "apps/standalone/finance/web/**",
      "products/finance/web/**",
      "products/finance/assets/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @telegram-system/finance-web start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
