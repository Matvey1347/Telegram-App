{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/standalone/finance/api/Dockerfile",
    "watchPatterns": [
      "apps/standalone/finance/api/**",
      "products/finance/api/**",
      "products/finance/bot/**",
      "packages/shared/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter finance-api prisma:migrate:deploy",
    "startCommand": "node apps/standalone/finance/api/dist/main.js",
    "healthcheckPath": "/api/health/ready",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
