{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "apps/web/**",
      "packages/shared/**",
      "products/**",
      "scripts/**",
      "Dockerfile",
      ".dockerignore",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway.json",
      ".nvmrc"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter api run db:deploy:safe",
    "startCommand": "node scripts/start-railway.mjs",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
