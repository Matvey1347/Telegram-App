{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter api exec prisma generate && pnpm --filter @telegram-system/shared build && pnpm --filter api build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter api run db:deploy:safe",
    "startCommand": "pnpm --filter api start:prod:railway",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
