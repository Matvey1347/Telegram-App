# EXAMPLE ONLY: fill locally; do not copy production configuration or credentials.
# Point only to a disposable PostgreSQL instance listening on 127.0.0.1.
DATABASE_URL=postgresql://LOCAL_USER@127.0.0.1:LOCAL_PORT/LOCAL_DATABASE
NODE_ENV=test
PORT=47851
FRONTEND_URL=http://127.0.0.1:47852
NEXT_PUBLIC_API_URL=http://127.0.0.1:47851/api
NEXT_TELEMETRY_DISABLED=1
COREPACK_ENABLE_NETWORK=0

# Generate two new independent random values for this isolated instance.
# JWT_SECRET is a local signing secret. BOT_TOKEN_ENCRYPTION_KEY must be
# base64 encoding of exactly 32 random bytes. Neither is a Telegram credential.
JWT_SECRET=REPLACE_WITH_NEW_LOCAL_RANDOM_SECRET
BOT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_NEW_LOCAL_32_BYTE_BASE64_KEY

# Offline stage: prohibit Telegram and paid AI.
CRM_RUNTIME_ENABLED=false
TELEGRAM_BOT_RUNTIME_ENVIRONMENT=LOCAL
INTERNAL_LEAD_DISCOVERY_ENABLED=true
INTERNAL_LEAD_DISCOVERY_GRANTS='[]'
INTERNAL_AI_ENABLED=false
INTERNAL_AI_OPENAI_API_KEY=
CRM_CHAT_MEDIA_ENABLED=false
