# Finance environment reference. Copy this file to `.env.local` and keep all
# real credentials only in that ignored file or in Finance's Railway service.

# Dedicated Finance database — never reuse Nexeloq DATABASE_URL.
FINANCE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finance?sslmode=require"
FINANCE_SESSION_SIGNING_KEY="replace-with-a-distinct-32-character-secret"
FINANCE_BOOTSTRAP_SIGNING_KEY="replace-with-a-distinct-32-character-secret"
FINANCE_API_PORT="4001"

# Finance root URLs. They are public origins, not secrets.
FINANCE_WEB_PUBLIC_URL="https://groshly.nexeloq.com"
FINANCE_API_PUBLIC_URL="https://api.groshly.nexeloq.com"

# Exactly one runtime may be selected: LOCAL, PRODUCTION, or blank to disable
# Finance Telegram delivery. LOCAL and PRODUCTION use distinct BotFather bots.
FINANCE_BOT_RUNTIME_ENVIRONMENT=""
FINANCE_BOT_LOCAL_USERNAME=""
FINANCE_BOT_LOCAL_TOKEN=""
FINANCE_BOT_LOCAL_WEBHOOK_SECRET=""
FINANCE_BOT_PRODUCTION_USERNAME=""
FINANCE_BOT_PRODUCTION_TOKEN=""
FINANCE_BOT_PRODUCTION_WEBHOOK_SECRET=""

# Read-only analytics access for the authenticated Nexeloq admin API.
FINANCE_ADMIN_ANALYTICS_WORKSPACE_ID=""
FINANCE_ADMIN_ANALYTICS_TOKEN=""

# Public browser API base. Local development uses a same-origin proxy.
NEXT_PUBLIC_FINANCE_API_URL="/api"
FINANCE_API_PROXY="true"
